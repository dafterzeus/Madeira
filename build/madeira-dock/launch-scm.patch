+void sh_launch_scm_prepare(const struct sh_observer *o)
+{
+    if (wide_flag(L"MADEIRA_DOCK_LAUNCH_SCM", L'0')) return;
+    SC_HANDLE manager = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT);
+    DWORD error = manager ? 0 : GetLastError();
+    if (!manager && !manager_process && sh_scm_error_means_absent(error))
+        error = start_manager(o, &manager, "launch-scm-started");
+    o->event("launch-scm", manager != NULL);
+    if (!manager) o->event("launch-scm-error", (int32_t)error);
+    if (manager) CloseServiceHandle(manager);
+}
